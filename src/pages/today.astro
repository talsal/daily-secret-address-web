---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout
	title="הכתובת של היום — הכתובת היומית לפי הרש״ש"
	description="הכתובת הקבלית של היום, לפי כתבי הרש״ש: ספירת החודש, מקום העמידה, הפסוק וצירוף ההוי״ה, וכל ספירות המערכת."
>
	<style>
		.wrap {
			max-width: 640px;
			margin: 0 auto;
			padding: 40px 20px 96px;
		}
		.back-link {
			display: inline-block;
			color: var(--text-dim);
			text-decoration: none;
			font-size: 0.9rem;
			margin-bottom: 24px;
		}
		.back-link:hover {
			color: var(--text);
		}
		h1 {
			font-size: 1.5rem;
			color: var(--gold-light);
			text-align: center;
			margin: 0 0 8px;
		}
		.instructions-link {
			display: block;
			text-align: center;
			color: var(--text-dim);
			font-size: 0.9rem;
			text-decoration: underline;
			margin-bottom: 28px;
		}
		.instructions-link:hover {
			color: var(--text);
		}
		#loading,
		#error {
			text-align: center;
			color: var(--text-dim);
			padding: 40px 0;
		}
		#error {
			color: #e08787;
			display: none;
		}
		#content {
			display: none;
		}
		.card {
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.08);
			border-radius: 16px;
			padding: 20px 22px;
			margin-bottom: 16px;
		}
		.date-line {
			text-align: center;
			font-size: 1.15rem;
			font-weight: 700;
			color: var(--gold-light);
		}
		.evar-line {
			text-align: center;
			color: var(--text-dim);
			margin-top: 4px;
		}
		.pasuk {
			text-align: center;
			font-size: 1.2rem;
			line-height: 1.9;
			margin: 4px 0;
		}
		:global(.pasuk .pasuk-highlight) {
			color: #4a9eff;
			font-size: 1.45rem;
			font-weight: 700;
		}
		.tzeruf {
			text-align: center;
			font-size: 1.1rem;
			line-height: 1.9;
			margin: 12px 0 4px;
		}
		.tzeruf .tzeruf-label {
			color: var(--text);
		}
		.tzeruf .tzeruf-letters {
			color: #e08787;
			font-size: 1.3rem;
		}
		:global(.season-row) {
			text-align: center;
			font-size: 0.92rem;
			color: var(--text-dim);
			padding: 10px 4px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		}
		.rosh-chodesh {
			text-align: center;
			font-size: 1.05rem;
			color: var(--gold-light);
			margin: 4px 0;
		}
		/* :global() -- .sefira-row/.season-row/.label/.value are created at runtime via
		   document.createElement in the client script below, not present in this
		   component's template at build time, so Astro's automatic style scoping
		   (which adds a data-astro-cid attribute selector) would never match them. */
		:global(.sefira-row) {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: 12px;
			padding: 10px 4px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		}
		:global(.sefira-row:last-child) {
			border-bottom: none;
		}
		:global(.sefira-row .label) {
			color: var(--text-dim);
			font-size: 0.95rem;
			flex: 0 1 auto;
			min-width: 0;
		}
		:global(.sefira-row .value) {
			font-weight: 700;
			font-size: 0.98rem;
			flex: 0 0 auto;
			white-space: nowrap;
		}
		.system-line {
			text-align: center;
			font-size: 0.95rem;
			line-height: 1.8;
			color: var(--text-dim);
		}
		.card h2 {
			margin: 0 0 10px;
			font-size: 0.85rem;
			color: var(--text-dim);
			font-weight: 600;
		}
	</style>

	<div class="wrap">
		<a class="back-link" href={withBase('')}>→ חזרה</a>
		<h1>הכתובת היומית על פי הרש״ש</h1>
		<a class="instructions-link" href={withBase('instructions')}>איך משתמשים בכתובת לכוונה? →</a>

		<div id="loading">טוען...</div>
		<div id="error">לא ניתן היה לטעון את התאריך העברי. נסו לרענן את העמוד.</div>

		<div id="content">
			<div class="card">
				<div class="date-line" id="dateLine"></div>
				<div class="evar-line" id="evarLine"></div>
			</div>

			<div class="card" id="pasukCard">
				<div class="pasuk" id="pasukLine"></div>
				<div class="tzeruf">
					<span class="tzeruf-label">צירוף השם: </span><span class="tzeruf-letters" id="tzerufLine"></span>
				</div>
			</div>

			<div class="card" id="roshChodeshCard" style="display: none">
				<div class="rosh-chodesh" id="roshChodeshLine"></div>
			</div>

			<div class="card" id="sefirotTable"></div>

			<div class="card">
				<h2>מערכת ימים</h2>
				<div class="system-line" id="systemLine"></div>
			</div>

			<div class="card">
				<h2>מערכת זמנים קטן</h2>
				<div class="system-line" id="systemTimesLine"></div>
			</div>
		</div>
	</div>

	<script>
		import { fetchHebrewDate, fetchMonthForSefira } from '../lib/hebrewDate';
		import { computeDailyContent, getPasukSegments } from '../lib/dailyContent';
		import { resolveEffectiveNow } from '../lib/effectiveHebrewDay';

		async function render() {
			const loading = document.getElementById('loading')!;
			const error = document.getElementById('error')!;
			const content = document.getElementById('content')!;

			try {
				const now = await resolveEffectiveNow();
				const hebrewDate = await fetchHebrewDate(now);

				const yesterday = new Date(now);
				yesterday.setDate(yesterday.getDate() - 1);
				const yesterdayHebrew = await fetchHebrewDate(yesterday);

				const monthForSefira = await fetchMonthForSefira(now, hebrewDate);

				const data = computeDailyContent({
					year: hebrewDate.year,
					month: hebrewDate.month,
					day: hebrewDate.day,
					weekday: hebrewDate.weekday,
					monthForSefira,
					yesterdayDay: yesterdayHebrew.day,
				});

				(document.getElementById('dateLine') as HTMLElement).textContent = data.hebrewDateLine;
				(document.getElementById('evarLine') as HTMLElement).textContent = `מקום עמידתו ${data.monthEvar}`;

				const pasukEl = document.getElementById('pasukLine') as HTMLElement;
				for (const segment of getPasukSegments(monthForSefira)) {
					if (segment.highlighted) {
						const span = document.createElement('span');
						span.className = 'pasuk-highlight';
						span.textContent = segment.text;
						pasukEl.append(span);
					} else {
						pasukEl.append(document.createTextNode(segment.text));
					}
				}

				(document.getElementById('tzerufLine') as HTMLElement).textContent = data.tzerufHavaya;

				if (data.roshChodeshLine) {
					(document.getElementById('roshChodeshLine') as HTMLElement).textContent = data.roshChodeshLine;
					(document.getElementById('roshChodeshCard') as HTMLElement).style.display = 'block';
				}

				const table = document.getElementById('sefirotTable')!;

				function addRow(label: string, value: string) {
					const row = document.createElement('div');
					row.className = 'sefira-row';
					const labelEl = document.createElement('span');
					labelEl.className = 'label';
					labelEl.textContent = label;
					const valueEl = document.createElement('span');
					valueEl.className = 'value';
					valueEl.textContent = value;
					row.append(labelEl, valueEl);
					table.append(row);
				}

				function addSeasonRow(text: string) {
					const row = document.createElement('div');
					row.className = 'season-row';
					row.textContent = text;
					table.append(row);
				}

				// כמו באפליקציה: בימי ר"ח (א'/ל') השורות הבודדות של ספירת היום/פרצוף
				// השבוע לא מוצגות בכלל -- השורה המיוחדת של ר"ח מוצגת במקומן.
				if (!data.roshChodeshLine) {
					addRow('ספירת היום', data.daySefira);
					addRow('פרצוף השבוע', data.weekFace);
				}
				addRow('ספירת החודש', data.monthSefira);
				addSeasonRow(data.seasonMaBen);
				addRow('ספירת השנה', data.yearSefira);
				addRow('ספירת העשרות שנה', data.decadeSefira);
				addRow('ספירת המאות שנה', data.hundredSefira);
				addRow('ספירת האלף שנה', data.thousandSefira);
				addRow('שנת שמיטה', data.shenatShemita);
				addRow('לשמיטה', data.shemita);
				addRow('יובל', data.yovel);

				(document.getElementById('systemLine') as HTMLElement).textContent = data.systemDaysLine;
				(document.getElementById('systemTimesLine') as HTMLElement).textContent = data.systemTimesLine;

				loading.style.display = 'none';
				content.style.display = 'block';
			} catch (e) {
				console.error(e);
				loading.style.display = 'none';
				error.style.display = 'block';
			}
		}

		render();
	</script>
</BaseLayout>
