---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout
	title="הכתובת היומית על פי הרש״ש"
	description="אפליקציית iOS המציגה כל יום ספירות, פרצופים וצירופי שם על פי הרש״ש, עם וידג'ט למסך הבית, תזכורת יומית והקדשה יומית."
>
	<style>
		.wrap {
			max-width: 720px;
			margin: 0 auto;
			padding: 64px 24px 96px;
			text-align: center;
		}
		.icon {
			width: 120px;
			height: 120px;
			border-radius: 28px;
			margin: 0 auto 28px;
			display: block;
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
		}
		h1 {
			font-size: 2.1rem;
			margin: 0 0 12px;
			color: var(--gold-light);
			font-weight: 700;
			line-height: 1.3;
		}
		.tagline {
			font-size: 1.15rem;
			color: var(--text-dim);
			margin: 0 0 32px;
			line-height: 1.6;
		}
		.cta-row {
			display: flex;
			flex-wrap: wrap;
			gap: 14px;
			justify-content: center;
			margin-bottom: 40px;
		}
		.badge {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			font-weight: 700;
			font-size: 1.05rem;
			padding: 16px 36px;
			border-radius: 14px;
			text-decoration: none;
			transition:
				transform 0.15s ease,
				box-shadow 0.15s ease;
		}
		.badge:hover {
			transform: translateY(-2px);
		}
		.store-badge {
			background: var(--gold);
			color: var(--navy2);
			box-shadow: 0 8px 24px rgba(212, 175, 90, 0.25);
		}
		.store-badge:hover {
			box-shadow: 0 12px 32px rgba(212, 175, 90, 0.35);
		}
		.web-badge {
			background: rgba(255, 255, 255, 0.08);
			color: var(--text);
			border: 1px solid rgba(255, 255, 255, 0.18);
		}
		.web-badge:hover {
			background: rgba(255, 255, 255, 0.14);
		}
		.instructions-link {
			display: block;
			text-align: center;
			color: var(--text-dim);
			font-size: 0.9rem;
			text-decoration: underline;
			margin-top: 4px;
		}
		.instructions-link:hover {
			color: var(--text);
		}
		.features {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 20px;
			margin: 40px 0 0;
			text-align: right;
		}
		@media (max-width: 520px) {
			.features {
				grid-template-columns: 1fr;
			}
			.cta-row {
				flex-direction: column;
				align-items: stretch;
			}
		}
		.feature {
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.08);
			border-radius: 16px;
			padding: 22px 20px;
		}
		.feature .emoji {
			font-size: 1.6rem;
			margin-bottom: 10px;
			display: block;
		}
		.feature h3 {
			margin: 0 0 6px;
			font-size: 1.05rem;
			color: var(--text);
		}
		.feature p {
			margin: 0;
			font-size: 0.92rem;
			color: var(--text-dim);
			line-height: 1.5;
		}
		footer {
			margin-top: 64px;
			color: var(--text-dim);
			font-size: 0.85rem;
			opacity: 0.7;
		}
	</style>

	<div class="wrap">
		<img class="icon" alt="אייקון האפליקציה" src={withBase('icon.png')} />
		<h1>הכתובת היומית על פי הרש״ש</h1>
		<p class="tagline">ספירות, פרצופים וצירופי שם — מחושב אוטומטית בכל יום לפי התאריך העברי</p>

		<div class="cta-row">
			<a class="badge store-badge" href="https://apps.apple.com/il/app/daily-secret/id1661464150" target="_blank" rel="noopener">
				הורידו ב-App Store
			</a>
			<a class="badge web-badge" href={withBase('today')}>נסה עכשיו בדפדפן</a>
		</div>

		<a class="instructions-link" href={withBase('instructions')}>איך משתמשים בכתובת לכוונה? →</a>

		<div class="features">
			<div class="feature">
				<span class="emoji">📜</span>
				<h3>תוכן יומי</h3>
				<p>ספירת היום, פרצוף השבוע וצירוף השם — מחושב אוטומטית, בלי צורך באינטרנט</p>
			</div>
			<div class="feature">
				<span class="emoji">📱</span>
				<h3>וידג'ט למסך הבית</h3>
				<p>מערכת הימים של היום, במבט אחד, ישירות ממסך הבית</p>
			</div>
			<div class="feature">
				<span class="emoji">🔔</span>
				<h3>תזכורת יומית</h3>
				<p>התראה בשעה שתבחרו, לפני התפילה</p>
			</div>
			<div class="feature">
				<span class="emoji">🕯️</span>
				<h3>הקדשה יומית</h3>
				<p>הקדישו יום לזכר או לרפואת יקיריכם, מוצג לכל המשתמשים</p>
			</div>
		</div>

		<footer>הכתובת היומית על פי הרש״ש</footer>
	</div>
</BaseLayout>
