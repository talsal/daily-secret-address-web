---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout
	title="הדפסת לוח — הכתובת היומית לפי הרש״ש"
	description="הדפסת לוח שבועי או חודשי של הכתובת היומית לפי הרש״ש, עם כל הפרטים לכל יום."
>
	<style is:global>
		.wrap {
			max-width: 1160px;
			margin: 0 auto;
			padding: 40px 20px 96px;
		}
		.back-link {
			display: inline-block;
			color: var(--text-dim);
			text-decoration: none;
			font-size: 0.9rem;
			margin-bottom: 24px;
		}
		.back-link:hover {
			color: var(--text);
		}
		h1.page-title {
			font-size: 1.5rem;
			color: var(--gold-light);
			text-align: center;
			margin: 0 0 20px;
		}
		.controls {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			justify-content: center;
			align-items: center;
			margin-bottom: 24px;
		}
		.controls select,
		.controls input,
		.controls button {
			background: rgba(255, 255, 255, 0.08);
			border: 1px solid rgba(255, 255, 255, 0.18);
			color: var(--text);
			padding: 9px 14px;
			border-radius: 999px;
			font-size: 0.95rem;
			font-family: inherit;
		}
		.controls button {
			cursor: pointer;
		}
		.controls button:hover {
			background: rgba(255, 255, 255, 0.14);
		}
		.controls .primary {
			background: var(--gold);
			color: #1a1a1a;
			border-color: var(--gold);
			font-weight: 700;
		}
		.controls .primary:hover {
			background: var(--gold-light);
		}
		.controls label {
			color: var(--text-dim);
			font-size: 0.9rem;
		}
		#status {
			text-align: center;
			color: var(--text-dim);
			margin: 20px 0;
		}
		#error {
			display: none;
			text-align: center;
			color: #ffb4b4;
			margin: 20px 0;
		}

		/* הגיליון עצמו: נייר לבן עם טקסט כהה -- זהה במסך ובהדפסה. הרוחב קבוע לפי גודל
		   עמוד A4 (חודש: לרוחב, שבוע: לאורך) כדי שהמסך יראה בדיוק מה שיודפס. */
		.sheet-scroll {
			overflow-x: auto;
		}
		.sheet {
			box-sizing: border-box;
			background: #fff;
			color: #111;
			border-radius: 8px;
			padding: 12px;
			margin: 0 auto;
			line-height: 1.35;
		}
		.sheet.month-layout {
			width: calc(1062px + 24px);
			--fs: 10px;
		}
		.sheet.week-layout {
			width: calc(733px + 24px);
			--fs: 13px;
		}
		.sheet-main {
			font-size: var(--fs);
		}
		.sheet h1 {
			margin: 0 0 6px;
			font-size: 1.5em;
			text-align: center;
		}
		.segment {
			margin-bottom: 14px;
		}
		.segment-title {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 6px 18px;
			align-items: center;
			border: 1.5px solid #333;
			border-radius: 6px;
			padding: 6px 10px;
			margin-bottom: 6px;
			break-inside: avoid;
		}
		.title-head {
			text-align: center;
		}
		.title-head h2 {
			margin: 0 0 2px;
			font-size: 1.6em;
		}
		.title-head .pasuk {
			font-size: 1.5em;
			margin: 2px 0;
		}
		.title-head .pasuk-highlight {
			color: #1565d8;
			font-weight: 700;
			font-size: 1.2em;
		}
		.title-head .tzerufim {
			margin: 2px 0 0;
		}
		.title-head .tzeruf-letters {
			color: #c0392b;
			font-size: 1.6em;
		}
		.title-head .tzeruf-ehyeh {
			margin-inline-start: 1.2em;
		}
		.segment-title dl {
			display: grid;
			grid-template-columns: max-content 1fr;
			gap: 1px 10px;
			margin: 0;
		}
		.segment-title dt {
			color: #555;
		}
		.segment-title dd {
			margin: 0;
			font-weight: 600;
		}
		table.days {
			width: 100%;
			border-collapse: collapse;
			table-layout: fixed;
		}
		table.days th,
		table.days td {
			border: 1px solid #999;
			padding: 1.5px 5px;
			vertical-align: middle;
			text-align: right;
		}
		table.days thead th {
			background: #eee;
			font-weight: 700;
			-webkit-print-color-adjust: exact;
			print-color-adjust: exact;
		}
		table.days thead {
			display: table-header-group;
		}
		table.days tr {
			break-inside: avoid;
		}
		table.days col.c-day {
			width: 11%;
		}
		table.days col.c-sefira {
			width: 9%;
		}
		table.days col.c-face {
			width: 9%;
		}
		table.days col.c-system {
			width: 48%;
		}
		table.days col.c-chag {
			width: 23%;
		}
		.week-layout table.days col.c-day {
			width: 14%;
		}
		.week-layout table.days col.c-sefira,
		.week-layout table.days col.c-face {
			width: 12%;
		}
		.week-layout table.days col.c-system {
			width: 40%;
		}
		.week-layout table.days col.c-chag {
			width: 22%;
		}
		table.days td.day-cell .gdate {
			margin-inline-start: 6px;
			color: #666;
			font-size: 0.85em;
		}
		table.days td.chag-cell {
			background: #f6f0dc;
			-webkit-print-color-adjust: exact;
			print-color-adjust: exact;
		}
		table.days tr.is-rc td.day-cell {
			font-weight: 700;
		}
		.neshama-section {
			margin-top: 24px;
			break-before: page;
			font-size: 13px;
		}
		.neshama-section h2 {
			font-size: 1.1rem;
			text-align: center;
			margin: 0 0 12px;
		}
		.neshama-item {
			text-align: center;
			margin-bottom: 18px;
			break-inside: avoid;
		}
		.neshama-item h3 {
			font-size: 0.95rem;
			margin: 0 0 6px;
		}
		.neshama-item img {
			max-width: 100%;
			max-height: 120mm;
			height: auto;
		}

		@media print {
			html,
			body {
				background: #fff !important;
				min-height: 0;
			}
			.no-print,
			.support-fab,
			.credit {
				display: none !important;
			}
			.wrap {
				max-width: none;
				padding: 0;
			}
			.sheet-scroll {
				overflow: visible;
			}
			.sheet {
				padding: 0;
				border-radius: 0;
			}
			.sheet.month-layout {
				width: 1062px;
			}
			.sheet.week-layout {
				width: 733px;
			}
		}
	</style>

	<div class="wrap">
		<a class="back-link no-print" href={withBase('today')}>→ חזרה לכתובת של היום</a>
		<h1 class="page-title no-print">הדפסת לוח</h1>

		<div class="controls no-print">
			<label for="mode">תצוגה:</label>
			<select id="mode">
				<option value="month">חודש עברי</option>
				<option value="currentWeek">השבוע הנוכחי (ראשון–שבת)</option>
				<option value="week">שבוע לבחירה</option>
			</select>
			<span id="pickers">
				<label for="daySelect" id="dayLabel">יום:</label>
				<select id="daySelect" aria-label="יום"></select>
				<label for="monthSelect">חודש:</label>
				<select id="monthSelect"></select>
				<select id="yearSelect" aria-label="שנה"></select>
			</span>
			<button type="button" class="primary" id="printBtn">הדפסה / שמירה כ־PDF</button>
		</div>
		<p style="text-align:center;color:var(--text-dim);font-size:0.85rem;margin:-10px 0 20px" class="no-print">
			השבוע הנוכחי = ראשון עד שבת של השבוע שבו אנחנו נמצאים. שבוע לבחירה = ראשון עד שבת של היום העברי שנבחר. חודש עברי = כל ימי החודש שנבחר.
		</p>

		<div id="status" class="no-print" role="status" aria-live="polite">טוען…</div>
		<div id="error" class="no-print" role="alert">לא ניתן היה לטעון את הנתונים. נסו לרענן את העמוד.</div>

		<div class="sheet-scroll"><div class="sheet" id="sheet" style="display:none"></div></div>
	</div>

	<script>
		import {
			fetchHebrewDate,
			fetchMonthForSefira,
			getHebrewYearInfo,
			convertHebrewToGregorian,
			type HebrewDate,
		} from '../lib/hebrewDate';
		import {
			computeDailyContent,
			getPasukSegments,
			MONTH_HEBREW,
			HEBREW_DAY_LETTERS,
			WEEKDAY_HEBREW,
			type DailySpiritualContent,
		} from '../lib/dailyContent';
		import { resolveEffectiveNow } from '../lib/effectiveHebrewDay';
		import { hebrewYearGematria } from '../lib/hebrewNumerals';
		import { getChagGadolContent, chagGadolLines, NESHAMA_DAYS, type ChagGadolContent } from '../lib/chagGadol';
		import { withBase } from '../lib/url';

		interface DayRow {
			date: Date;
			hebrew: HebrewDate;
			monthForSefira: string;
			data: DailySpiritualContent;
			chag: ChagGadolContent | null;
		}

		const modeEl = document.getElementById('mode') as HTMLSelectElement;
		const daySelectEl = document.getElementById('daySelect') as HTMLSelectElement;
		const dayLabelEl = document.getElementById('dayLabel') as HTMLElement;
		const pickersEl = document.getElementById('pickers') as HTMLElement;
		let effectiveToday: Date | null = null;
		const monthSelectEl = document.getElementById('monthSelect') as HTMLSelectElement;
		const yearSelectEl = document.getElementById('yearSelect') as HTMLSelectElement;
		const sheet = document.getElementById('sheet') as HTMLElement;
		const pageStyleEl = document.createElement('style');
		document.head.append(pageStyleEl);
		const statusEl = document.getElementById('status') as HTMLElement;
		const errorEl = document.getElementById('error') as HTMLElement;

		const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

		function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
			const node = document.createElement(tag);
			if (className) node.className = className;
			if (text !== undefined) node.textContent = text;
			return node;
		}

		function noon(date: Date): Date {
			return new Date(date.getFullYear(), date.getMonth(), date.getDate(), 12, 0, 0);
		}

		function addDays(date: Date, n: number): Date {
			const d = new Date(date);
			d.setDate(d.getDate() + n);
			return noon(d);
		}

		// בונה את רשימת הימים (עם כל הנתונים) לשבוע/חודש. בחודש -- תאריך הפתיחה
		// מומר פעם אחת ושאר הימים מחושבים מקומית (יום עברי d = פתיחה + d-1);
		// בשבוע -- כל יום נשלף מ-Hebcal.
		async function buildRows(mode: string, anchor: Date, hebrewMonth: { year: number; month: string }): Promise<DayRow[]> {
			let dates: Date[];
			let hebrews: HebrewDate[];
			let yesterdayOfFirst: number;

			if (mode === 'month') {
				const yearInfo = await getHebrewYearInfo(hebrewMonth.year);
				const dayCount = yearInfo.dayCounts[hebrewMonth.month] ?? 30;
				const start = await convertHebrewToGregorian(hebrewMonth.year, hebrewMonth.month, 1);
				dates = Array.from({ length: dayCount }, (_, i) => addDays(start, i));
				hebrews = dates.map((date, i) => ({
					year: hebrewMonth.year,
					month: hebrewMonth.month,
					day: i + 1,
					weekday: WEEKDAYS[date.getDay()],
					hebrewText: '',
				}));
				// יום ל' שייך לכתובת החודש הבא: את ל' של החודש הקודם מציגים בראש החודש הזה,
				// וה-ל' של החודש הזה יוצג בראש החודש הבא.
				const dayBefore = addDays(start, -1);
				const prev = await fetchHebrewDate(dayBefore);
				const keep = hebrews.map((h) => h.day !== 30);
				dates = dates.filter((_, i) => keep[i]);
				hebrews = hebrews.filter((_, i) => keep[i]);
				if (prev.day === 30) {
					dates.unshift(dayBefore);
					hebrews.unshift(prev);
					yesterdayOfFirst = 29;
				} else {
					yesterdayOfFirst = prev.day;
				}
			} else {
				const start = addDays(anchor, -anchor.getDay());
				dates = Array.from({ length: 7 }, (_, i) => addDays(start, i));
				const fetched = await Promise.all([-1, ...dates.map((_, i) => i)].map((i) => fetchHebrewDate(addDays(start, i))));
				yesterdayOfFirst = fetched[0].day;
				hebrews = fetched.slice(1);
			}

			return Promise.all(
				dates.map(async (date, i) => {
					const hebrew = hebrews[i];
					const monthForSefira = hebrew.day === 30 ? await fetchMonthForSefira(date, hebrew) : hebrew.month;
					const yesterdayDay = i === 0 ? yesterdayOfFirst : hebrews[i - 1].day;
					const data = computeDailyContent({
						year: hebrew.year,
						month: hebrew.month,
						day: hebrew.day,
						weekday: hebrew.weekday,
						monthForSefira,
						yesterdayDay,
					});
					const chag = await getChagGadolContent(hebrew.month, hebrew.day, hebrew.year);
					return { date, hebrew, monthForSefira, data, chag };
				})
			);
		}

		function buildSegmentTitle(rows: DayRow[]): HTMLElement {
			const titleRow = rows[0];
			const d = titleRow.data;
			const box = el('section', 'segment-title');

			const head = el('div', 'title-head');
			head.append(el('h2', undefined, `${MONTH_HEBREW[titleRow.monthForSefira] ?? titleRow.monthForSefira} ${hebrewYearGematria(titleRow.hebrew.year)}`));

			const pasuk = el('div', 'pasuk');
			for (const seg of getPasukSegments(titleRow.monthForSefira)) {
				if (seg.highlighted) pasuk.append(el('span', 'pasuk-highlight', seg.text));
				else pasuk.append(document.createTextNode(seg.text));
			}
			head.append(pasuk);

			const tz = el('div', 'tzerufim');
			tz.append(document.createTextNode('צירוף השם: '));
			tz.append(el('span', 'tzeruf-letters', d.tzerufHavaya));
			tz.append(el('span', 'tzeruf-letters tzeruf-ehyeh', d.tzerufEhyeh));
			head.append(tz);
			box.append(head);

			const dl = el('dl');
			const add = (label: string, value: string) => {
				dl.append(el('dt', undefined, label), el('dd', undefined, value));
			};
			add('מקום עמידתו', d.monthEvar);
			add('ספירת החודש', d.monthSefira);
			add('עונה', d.seasonMaBen);
			add('ספירות השנה', `${d.yearSefira} · ${d.decadeSefira} (עשרות) · ${d.hundredSefira} (מאות) · ${d.thousandSefira} (אלף)`);
			add('שמיטה / שמיטה / יובל', `${d.shenatShemita} · ${d.shemita} · ${d.yovel}`);
			add('מערכת זמנים קטן', d.systemTimesLine);
			// שורת ספירות השנה של מערכת זמנים גדול זהה בכל ימי החג, ולכן מופיעה כאן פעם אחת
			const chagRow = rows.find((r) => r.chag);
			if (chagRow) {
				add('מערכת זמנים גדול (שנה)', chagGadolLines(chagRow.chag!, d, hebrewYearGematria(chagRow.hebrew.year)).line3);
			}
			box.append(dl);
			return box;
		}

		function buildTable(rows: DayRow[]): HTMLTableElement {
			const hasChag = rows.some((r) => r.chag);
			const table = el('table', 'days');
			const colgroup = el('colgroup');
			for (const c of hasChag ? ['c-day', 'c-sefira', 'c-face', 'c-system', 'c-chag'] : ['c-day', 'c-sefira', 'c-face', 'c-system']) {
				colgroup.append(el('col', c));
			}
			table.append(colgroup);

			const head = el('thead');
			const headRow = el('tr');
			for (const h of hasChag ? ['יום', 'ספירת היום', 'פרצוף השבוע', 'מערכת ימים', 'מערכת זמנים גדול (חגים)'] : ['יום', 'ספירת היום', 'פרצוף השבוע', 'מערכת ימים']) {
				headRow.append(el('th', undefined, h));
			}
			head.append(headRow);
			table.append(head);

			const body = el('tbody');
			for (const row of rows) {
				const { hebrew, data } = row;
				const tr = el('tr', data.roshChodeshLine ? 'is-rc' : undefined);

				const dayCell = el('td', 'day-cell');
				dayCell.append(document.createTextNode(`${HEBREW_DAY_LETTERS[hebrew.day] ?? hebrew.day} · ${WEEKDAY_HEBREW[hebrew.weekday] ?? hebrew.weekday}`));
				// יום ל' שייך לכתובת החודש הבא -- מציינים את החודש האמיתי שלו
				if (hebrew.month !== row.monthForSefira) {
					dayCell.append(el('span', 'gdate', MONTH_HEBREW[hebrew.month] ?? hebrew.month));
				}
				tr.append(dayCell);

				// כמו באתר/באפליקציה: בימי ר"ח השורה המיוחדת מחליפה את ספירת היום ופרצוף השבוע
				if (data.roshChodeshLine) {
					const rc = el('td', undefined, data.roshChodeshLine);
					rc.colSpan = 2;
					tr.append(rc);
				} else {
					tr.append(el('td', undefined, data.daySefira), el('td', undefined, data.weekFace));
				}
				tr.append(el('td', undefined, data.systemDaysLine));

				if (hasChag) {
					const chagCell = el('td', 'chag-cell');
					if (row.chag) {
						const lines = chagGadolLines(row.chag, data, hebrewYearGematria(hebrew.year));
						chagCell.append(el('div', undefined, lines.line1));
						if (lines.line2) chagCell.append(el('div', undefined, lines.line2));
						if (hebrew.month === 'Tishrei' && NESHAMA_DAYS.has(hebrew.day)) {
							chagCell.append(el('div', undefined, 'המשכת אור פנימי — ראו בסוף הלוח'));
						}
					}
					tr.append(chagCell);
				}
				body.append(tr);
			}
			table.append(body);
			return table;
		}

		function buildNeshamaSection(rows: DayRow[]): HTMLElement | null {
			const days = rows.filter((r) => r.hebrew.month === 'Tishrei' && NESHAMA_DAYS.has(r.hebrew.day));
			if (days.length === 0) return null;
			const section = el('section', 'neshama-section');
			section.append(el('h2', undefined, 'המשכת אור פנימי (י״א–ט״ו בתשרי)'));
			for (const r of days) {
				const item = el('div', 'neshama-item');
				item.append(el('h3', undefined, `${HEBREW_DAY_LETTERS[r.hebrew.day]} בתשרי`));
				const img = el('img');
				img.src = withBase(`kavanot/tishrei-${r.hebrew.day}.png`);
				img.alt = `המשכת אור פנימי ליום ${HEBREW_DAY_LETTERS[r.hebrew.day]} בתשרי`;
				item.append(img);
				section.append(item);
			}
			return section;
		}

		let generation = 0;

		async function render() {
			const my = ++generation;
			const mode = modeEl.value;
			const hebrewMonth = { year: parseInt(yearSelectEl.value, 10), month: monthSelectEl.value };
			if (!hebrewMonth.year || !hebrewMonth.month) return;

			statusEl.style.display = 'block';
			statusEl.textContent = 'טוען…';
			errorEl.style.display = 'none';
			sheet.style.display = 'none';

			try {
				let anchor: Date;
				if (mode === 'week') {
					anchor = await convertHebrewToGregorian(hebrewMonth.year, hebrewMonth.month, parseInt(daySelectEl.value, 10) || 1);
				} else if (mode === 'currentWeek') {
					effectiveToday ??= await resolveEffectiveNow();
					anchor = effectiveToday;
				} else {
					anchor = new Date();
				}
				if (my !== generation) return;
				const rows = await buildRows(mode === 'month' ? 'month' : 'week', anchor, hebrewMonth);
				if (my !== generation) return;

				sheet.innerHTML = '';
				sheet.className = `sheet ${mode === 'month' ? 'month-layout' : 'week-layout'}`;
				pageStyleEl.textContent = `@page { size: A4 ${mode === 'month' ? 'landscape' : 'portrait'}; margin: 8mm; }`;

				// כל הלוח (כותרת + טבלאות) נכנס לעמוד אחד; נספח התמונות (אם יש) בעמודים נפרדים אחריו
				const main = el('div', 'sheet-main');
				main.append(el('h1', undefined, `הכתובת היומית על פי הרש״ש — ${mode === 'month' ? 'לוח חודשי' : 'לוח שבועי'}`));

				// מקבצים ימים רצופים לפי חודש הכתובת (monthForSefira): יום ל' נכלל בחודש הבא,
				// ושבוע שחוצה חודשים מקבל כותרת לכל חודש.
				const segments: DayRow[][] = [];
				for (const row of rows) {
					const last = segments[segments.length - 1];
					if (last && last[0].monthForSefira === row.monthForSefira) last.push(row);
					else segments.push([row]);
				}
				for (const rowsOfMonth of segments) {
					const seg = el('div', 'segment');
					seg.append(buildSegmentTitle(rowsOfMonth), buildTable(rowsOfMonth));
					main.append(seg);
				}
				sheet.append(main);
				const neshama = buildNeshamaSection(rows);
				if (neshama) sheet.append(neshama);

				statusEl.style.display = 'none';
				sheet.style.display = 'block';
				fitMainToPage();
			} catch (e) {
				console.error(e);
				if (my !== generation) return;
				statusEl.style.display = 'none';
				errorEl.style.display = 'block';
			}
		}

		// בורר החודש העברי: שנה (באותיות) + חודשי אותה שנה, כמו בעמוד "הכתובת של היום"
		const YEARS_BACK = 100;
		const YEARS_FORWARD = 30;

		function populateYears(selectedYear: number) {
			yearSelectEl.innerHTML = '';
			for (let y = selectedYear + YEARS_FORWARD; y >= selectedYear - YEARS_BACK; y--) {
				const option = document.createElement('option');
				option.value = String(y);
				option.textContent = hebrewYearGematria(y);
				yearSelectEl.append(option);
			}
			yearSelectEl.value = String(selectedYear);
		}

		async function populateMonths(year: number, preferredMonth: string) {
			const info = await getHebrewYearInfo(year);
			monthSelectEl.innerHTML = '';
			for (const month of info.monthOrder) {
				const option = document.createElement('option');
				option.value = month;
				option.textContent = MONTH_HEBREW[month] ?? month;
				monthSelectEl.append(option);
			}
			// אדר א'/ב' בשנה לא מעוברת (ולהפך) -- נופלים ל"אדר"/לחודש הראשון
			if (info.monthOrder.includes(preferredMonth)) monthSelectEl.value = preferredMonth;
			else if ((preferredMonth === 'Adar I' || preferredMonth === 'Adar II') && info.monthOrder.includes('Adar')) monthSelectEl.value = 'Adar';
			else if (preferredMonth === 'Adar' && info.monthOrder.includes('Adar II')) monthSelectEl.value = 'Adar II';
			else monthSelectEl.value = info.monthOrder[0];
		}

		async function populateDays(selectedDay: number) {
			const info = await getHebrewYearInfo(parseInt(yearSelectEl.value, 10));
			const dayCount = info.dayCounts[monthSelectEl.value] ?? 30;
			daySelectEl.innerHTML = '';
			for (let d = 1; d <= dayCount; d++) {
				const option = document.createElement('option');
				option.value = String(d);
				option.textContent = HEBREW_DAY_LETTERS[d] ?? String(d);
				daySelectEl.append(option);
			}
			daySelectEl.value = String(Math.min(selectedDay, dayCount));
		}

		function applyModeVisibility() {
			const mode = modeEl.value;
			pickersEl.style.display = mode === 'currentWeek' ? 'none' : '';
			const hideDay = mode === 'month';
			daySelectEl.style.display = hideDay ? 'none' : '';
			dayLabelEl.style.display = hideDay ? 'none' : '';
		}

		modeEl.addEventListener('change', () => {
			applyModeVisibility();
			render();
		});
		daySelectEl.addEventListener('change', render);
		monthSelectEl.addEventListener('change', async () => {
			await populateDays(parseInt(daySelectEl.value, 10) || 1);
			await render();
		});
		yearSelectEl.addEventListener('change', async () => {
			await populateMonths(parseInt(yearSelectEl.value, 10), monthSelectEl.value);
			await populateDays(parseInt(daySelectEl.value, 10) || 1);
			await render();
		});
		// התאמת הלוח לעמוד אחד: מחפשים את גודל הגופן הגדול ביותר שבו הלוח הראשי (בלי נספח
		// התמונות) עדיין נכנס בגובה העמוד -- גם מגדילים כשיש מקום פנוי וגם מקטינים כשצפוף.
		// מידות העמוד בפיקסלים (96dpi) לפי A4 פחות שוליים של 8 מ"מ.
		const PAGE_PX = { landscape: { w: 1062, h: 733 }, portrait: { w: 733, h: 1062 } };
		const FONT_RANGE = { month: { min: 6, max: 15 }, week: { min: 9, max: 18 } };

		function fitMainToPage() {
			const main = sheet.querySelector('.sheet-main') as HTMLElement | null;
			if (!main) return;
			const isMonth = sheet.classList.contains('month-layout');
			const limit = (isMonth ? PAGE_PX.landscape.h : PAGE_PX.portrait.h) * 0.98;
			const range = isMonth ? FONT_RANGE.month : FONT_RANGE.week;
			let low = range.min;
			let high = range.max;
			for (let i = 0; i < 8; i++) {
				const mid = (low + high) / 2;
				main.style.fontSize = `${mid}px`;
				if (main.getBoundingClientRect().height <= limit) low = mid;
				else high = mid;
			}
			main.style.fontSize = `${low}px`;
		}

		window.addEventListener('beforeprint', fitMainToPage);

		document.getElementById('printBtn')!.addEventListener('click', () => window.print());

		(async () => {
			const hebrewToday = await fetchHebrewDate(await resolveEffectiveNow());
			populateYears(hebrewToday.year);
			await populateMonths(hebrewToday.year, hebrewToday.month);
			await populateDays(hebrewToday.day);
			applyModeVisibility();
			await render();
		})();
	</script>
</BaseLayout>
